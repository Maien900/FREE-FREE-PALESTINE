<!DOCTYPE html>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Animated Website</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  min-height: 100vh;
  background: #050816;
  color: white;
  font-family: Arial, sans-serif;
  overflow-x: hidden;
}

nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 8%;
  border-bottom: 1px solid #26304a;
}

.logo {
  color: #00f5c4;
  font-size: 22px;
  font-weight: bold;
}

nav a {
  color: white;
  text-decoration: none;
  margin-left: 18px;
  font-size: 14px;
}

.hero {
  min-height: 85vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 30px 20px;
  position: relative;
}

.glow {
  position: absolute;
  width: 230px;
  height: 230px;
  background: #00f5c4;
  filter: blur(100px);
  opacity: 0.22;
  animation: pulse 3s infinite alternate;
}

h1 {
  position: relative;
  font-size: clamp(36px, 8vw, 68px);
  margin-bottom: 18px;
  animation: appear 1.2s ease;
}

h1 span {
  color: #00f5c4;
}

.hero p {
  color: #b9c4d9;
  line-height: 1.8;
  max-width: 500px;
  animation: appear 1.8s ease;
}

.btn {
  display: inline-block;
  margin-top: 28px;
  padding: 14px 26px;
  background: #00f5c4;
  color: #06111c;
  border: none;
  border-radius: 30px;
  font-weight: bold;
  text-decoration: none;
  cursor: pointer;
  transition: .3s;
}

.btn:hover {
  transform: scale(1.07);
  box-shadow: 0 0 25px #00f5c4;
}

section.info {
  padding: 60px 20px;
  text-align: center;
  background: #0b1120;
}

.info h2 {
  color: #00f5c4;
  margin-bottom: 18px;
}

.info p {
  max-width: 600px;
  margin: auto;
  color: #b9c4d9;
  line-height: 1.8;
}

footer {
  padding: 25px 12px;
  text-align: center;
  color: #a6b1c6;
  font-size: 13px;
}

@keyframes pulse {
  from { transform: scale(.8); opacity: .12; }
  to { transform: scale(1.3); opacity: .32; }
}

@keyframes appear {
  from { opacity: 0; transform: translateY(25px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 480px) {
  nav { padding: 18px 5%; }
  .logo { font-size: 17px; }
  nav a { margin-left: 8px; font-size: 12px; }
}
</style>
</head>

<body>
<nav>
  <div class="logo">MY WEBSITE</div>
  <div>
    <a href="#home">Home</a>
    <a href="#about">About</a>
  </div>
</nav>

<main>
  <section class="hero" id="home">
    <div class="glow"></div>
    <h1>Welcome to <span>My World</span></h1>
    <p>
      Explore my creative world.
      Beautiful design, smooth animations,
      and a website made with HTML, CSS and JavaScript.
    </p>
    <a href="#about" class="btn">Explore More ↗</a>
  </section>

  <section class="info" id="about">
    <h2>About My Website</h2>
    <p>
      This is my personal website project.
      I am learning web development and creating
      amazing things using code.
    </p>
    <button class="btn" onclick="showMessage()">
      Click Me
    </button>
    <p id="message" style="margin-top:20px"></p>
  </section>
</main>

<footer>
  Made with ❤️ using HTML, CSS & JavaScript
</footer>

<script>
function showMessage() {
  document.getElementById("message").textContent =
    "Hello! Thanks for visiting my website! ✨";
}
</script>
</body>
</html>
